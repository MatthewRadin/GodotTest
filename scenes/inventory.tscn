[gd_scene load_steps=3 format=3]

[ext_resource type="Theme" path="res://theme/pawn_theme.tres" id="1"]
[ext_resource type="Script" path="res://scripts/inventory.gd" id="2"]

[node name="Root" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1")
script = ExtResource("2")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.18, 0.13, 0.094, 1.0)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TopBar" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="BackButton" type="Button" parent="Margin/Column/TopBar"]
layout_mode = 2
custom_minimum_size = Vector2(200, 44)
text = "< Back (Esc)"

[node name="TitleLabel" type="Label" parent="Margin/Column/TopBar"]
layout_mode = 2
text = "Inventory"
theme_type_variation = &"TitleLabel"

[node name="EmptyLabel" type="Label" parent="Margin/Column"]
layout_mode = 2
text = "Your inventory is empty. Buy something at the desk!"
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(0.6, 0.576, 0.47, 1.0)
unique_name_in_owner = true

[node name="Row" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 16
size_flags_vertical = 3
unique_name_in_owner = true

[node name="Scroll" type="ScrollContainer" parent="Margin/Column/Row"]
layout_mode = 2
custom_minimum_size = Vector2(420, 0)

[node name="ItemList" type="VBoxContainer" parent="Margin/Column/Row/Scroll"]
layout_mode = 2
theme_override_constants/separation = 8
size_flags_horizontal = 3
unique_name_in_owner = true

[node name="Detail" type="PanelContainer" parent="Margin/Column/Row"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Box" type="VBoxContainer" parent="Margin/Column/Row/Detail"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Picture" type="ColorRect" parent="Margin/Column/Row/Detail/Box"]
layout_mode = 2
custom_minimum_size = Vector2(0, 160)
color = Color(0.42, 0.32, 0.25, 1.0)

[node name="Tag" type="Label" parent="Margin/Column/Row/Detail/Box/Picture"]
layout_mode = 0
offset_left = 6
offset_top = 4
offset_right = 200
offset_bottom = 30
theme_override_font_sizes/font_size = 14
text = "[ item image placeholder ]"

[node name="NameLabel" type="Label" parent="Margin/Column/Row/Detail/Box"]
layout_mode = 2
text = ""
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 32
unique_name_in_owner = true

[node name="DescLabel" type="Label" parent="Margin/Column/Row/Detail/Box"]
layout_mode = 2
text = ""
theme_type_variation = &"MutedLabel"
unique_name_in_owner = true

[node name="DefectsLabel" type="Label" parent="Margin/Column/Row/Detail/Box"]
layout_mode = 2
text = ""
unique_name_in_owner = true

[node name="WorthLabel" type="Label" parent="Margin/Column/Row/Detail/Box"]
layout_mode = 2
text = ""
theme_override_font_sizes/font_size = 22
unique_name_in_owner = true

[node name="CleanedLabel" type="Label" parent="Margin/Column/Row/Detail/Box"]
layout_mode = 2
text = ""
theme_type_variation = &"GoodLabel"
theme_override_font_sizes/font_size = 22
unique_name_in_owner = true

[node name="Buttons" type="HBoxContainer" parent="Margin/Column/Row/Detail/Box"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="InspectButton" type="Button" parent="Margin/Column/Row/Detail/Box/Buttons"]
layout_mode = 2
custom_minimum_size = Vector2(160, 44)
text = "Inspect"

[node name="RepairButton" type="Button" parent="Margin/Column/Row/Detail/Box/Buttons"]
layout_mode = 2
custom_minimum_size = Vector2(160, 44)
text = "Repair"

[connection signal="pressed" from="Margin/Column/TopBar/BackButton" to="." method="_on_back_button_pressed"]
[connection signal="pressed" from="Margin/Column/Row/Detail/Box/Buttons/InspectButton" to="." method="_on_inspect_button_pressed"]
[connection signal="pressed" from="Margin/Column/Row/Detail/Box/Buttons/RepairButton" to="." method="_on_repair_button_pressed"]
