[gd_scene load_steps=3 format=3]

[ext_resource type="Theme" path="res://theme/pawn_theme.tres" id="1"]
[ext_resource type="Script" path="res://scripts/repair.gd" id="2"]

[node name="Root" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1")
script = ExtResource("2")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.18, 0.13, 0.094, 1.0)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TopBar" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="BackButton" type="Button" parent="Margin/Column/TopBar"]
layout_mode = 2
custom_minimum_size = Vector2(200, 44)
text = "< Return to Shop"

[node name="TitleLabel" type="Label" parent="Margin/Column/TopBar"]
layout_mode = 2
text = "Repair Bench"
theme_type_variation = &"TitleLabel"

[node name="EmptyLabel" type="Label" parent="Margin/Column"]
layout_mode = 2
text = "Your inventory is empty. Buy something first!"
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(0.6, 0.576, 0.47, 1.0)
unique_name_in_owner = true

[node name="Row" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 16
size_flags_vertical = 3
unique_name_in_owner = true

[node name="ItemCard" type="PanelContainer" parent="Margin/Column/Row"]
layout_mode = 2
custom_minimum_size = Vector2(320, 0)

[node name="Box" type="VBoxContainer" parent="Margin/Column/Row/ItemCard"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Picture" type="ColorRect" parent="Margin/Column/Row/ItemCard/Box"]
layout_mode = 2
custom_minimum_size = Vector2(0, 200)
color = Color(0.42, 0.32, 0.25, 1.0)

[node name="Tag" type="Label" parent="Margin/Column/Row/ItemCard/Box/Picture"]
layout_mode = 0
offset_left = 6
offset_top = 4
offset_right = 200
offset_bottom = 30
theme_override_font_sizes/font_size = 14
text = "[ item image placeholder ]"

[node name="InfoLabel" type="Label" parent="Margin/Column/Row/ItemCard/Box"]
layout_mode = 2
text = ""
theme_override_font_sizes/font_size = 22
unique_name_in_owner = true

[node name="QualityHint" type="Label" parent="Margin/Column/Row/ItemCard/Box"]
layout_mode = 2
text = "Item quality"
theme_type_variation = &"MutedLabel"

[node name="QualityBar" type="ProgressBar" parent="Margin/Column/Row/ItemCard/Box"]
layout_mode = 2
custom_minimum_size = Vector2(0, 28)
value = 50.0
unique_name_in_owner = true

[node name="NextButton" type="Button" parent="Margin/Column/Row/ItemCard/Box"]
layout_mode = 2
custom_minimum_size = Vector2(0, 40)
text = "Next Item"

[node name="ToolsCard" type="PanelContainer" parent="Margin/Column/Row"]
layout_mode = 2
custom_minimum_size = Vector2(340, 0)

[node name="Box" type="VBoxContainer" parent="Margin/Column/Row/ToolsCard"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="ToolsHeading" type="Label" parent="Margin/Column/Row/ToolsCard/Box"]
layout_mode = 2
text = "Tools"
theme_type_variation = &"HeadingLabel"

[node name="Tools" type="GridContainer" parent="Margin/Column/Row/ToolsCard/Box"]
layout_mode = 2
columns = 2
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10
unique_name_in_owner = true

[node name="HammerButton" type="Button" parent="Margin/Column/Row/ToolsCard/Box/Tools"]
layout_mode = 2
custom_minimum_size = Vector2(150, 56)
text = "Hammer"

[node name="ScrewdriverButton" type="Button" parent="Margin/Column/Row/ToolsCard/Box/Tools"]
layout_mode = 2
custom_minimum_size = Vector2(150, 56)
text = "Screwdriver"

[node name="MagnifyingGlassButton" type="Button" parent="Margin/Column/Row/ToolsCard/Box/Tools"]
layout_mode = 2
custom_minimum_size = Vector2(150, 56)
text = "Magnifying Glass"

[node name="ScissorsButton" type="Button" parent="Margin/Column/Row/ToolsCard/Box/Tools"]
layout_mode = 2
custom_minimum_size = Vector2(150, 56)
text = "Scissors"

[node name="SanderButton" type="Button" parent="Margin/Column/Row/ToolsCard/Box/Tools"]
layout_mode = 2
custom_minimum_size = Vector2(150, 56)
text = "Sander"

[node name="GlueButton" type="Button" parent="Margin/Column/Row/ToolsCard/Box/Tools"]
layout_mode = 2
custom_minimum_size = Vector2(150, 56)
text = "Glue"

[node name="LogLabel" type="Label" parent="Margin/Column/Row/ToolsCard/Box"]
layout_mode = 2
text = "Pick a tool to start repairing."
theme_type_variation = &"MutedLabel"
unique_name_in_owner = true

[node name="ComputerCard" type="PanelContainer" parent="Margin/Column/Row"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Box" type="VBoxContainer" parent="Margin/Column/Row/ComputerCard"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="ComputerHeading" type="Label" parent="Margin/Column/Row/ComputerCard/Box"]
layout_mode = 2
text = "Price Computer"
theme_type_variation = &"HeadingLabel"

[node name="PriceLabel" type="Label" parent="Margin/Column/Row/ComputerCard/Box"]
layout_mode = 2
text = ""
unique_name_in_owner = true

[connection signal="pressed" from="Margin/Column/TopBar/BackButton" to="." method="_on_back_button_pressed"]
[connection signal="pressed" from="Margin/Column/Row/ItemCard/Box/NextButton" to="." method="_on_next_button_pressed"]
